    <void:Dataset rdf:about="https://artgallery.yale.edu/">
        <dcterms:title xml:lang="en">Yale University Art Gallery</dcterms:title>
        <dcterms:description xml:lang="en">The Yale University Art Gallery is an art museum in New Haven, Connecticut. It houses a major encyclopedic collection of art in several interconnected buildings on the campus of Yale University.</dcterms:description>
